rules_version = '2';

// Firebase Storage rules for Bhangari Exchange.
// Users may upload/read images under their own UID folder in `pickups/`.

service firebase.storage {
  match /b/{bucket}/o {
    match /pickups/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Fallback: reject anything not under an authenticated user folder
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}