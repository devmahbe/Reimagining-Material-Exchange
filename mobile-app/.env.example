# ─── Firebase ───────────────────────────────────────────────────
# Copy this file to .env and fill in your real credentials
# Get values from: Firebase Console → Project Settings → Your Apps

EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# ─── bKash Sandbox ──────────────────────────────────────────────
# Register at https://developer.bka.sh → Create App → get sandbox credentials
# Leave blank to use demo mode

EXPO_PUBLIC_BKASH_APP_KEY=your_bkash_sandbox_app_key
EXPO_PUBLIC_BKASH_APP_SECRET=your_bkash_sandbox_app_secret
EXPO_PUBLIC_BKASH_USERNAME=your_bkash_sandbox_username
EXPO_PUBLIC_BKASH_PASSWORD=your_bkash_sandbox_password
EXPO_PUBLIC_BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
